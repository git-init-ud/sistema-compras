{
  "info": {
    "name": "sistema-compras",
    "description": "cliente-api, producto-api y compra-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "clienteApiUrl", "value": "http://localhost:3001" },
    { "key": "productoApiUrl", "value": "http://localhost:3002" },
    { "key": "compraApiUrl", "value": "http://localhost:3003" }
  ],
  "item": [
    {
      "name": "cliente-api",
      "item": [
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "url": "{{clienteApiUrl}}/clientes"
          }
        },
        {
          "name": "Obtener cliente por id",
          "request": {
            "method": "GET",
            "url": "{{clienteApiUrl}}/clientes/1"
          }
        },
        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mariana Ríos\",\n  \"email\": \"mariana.rios@example.com\"\n}"
            },
            "url": "{{clienteApiUrl}}/clientes"
          }
        }
      ]
    },
    {
      "name": "producto-api",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "url": "{{productoApiUrl}}/productos"
          }
        },
        {
          "name": "Obtener producto por id",
          "request": {
            "method": "GET",
            "url": "{{productoApiUrl}}/productos/1"
          }
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Monitor 24 pulgadas\",\n  \"precio\": 520000,\n  \"stock\": 8\n}"
            },
            "url": "{{productoApiUrl}}/productos"
          }
        }
      ]
    },
    {
      "name": "compra-api",
      "item": [
        {
          "name": "Listar compras",
          "request": {
            "method": "GET",
            "url": "{{compraApiUrl}}/compras"
          }
        },
        {
          "name": "Obtener compra por id",
          "request": {
            "method": "GET",
            "url": "{{compraApiUrl}}/compras/1"
          }
        },
        {
          "name": "Crear compra - caso exitoso",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"productoId\": 2,\n  \"cantidad\": 3\n}"
            },
            "url": "{{compraApiUrl}}/compras"
          }
        },
        {
          "name": "Crear compra - cliente inexistente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 99,\n  \"productoId\": 1,\n  \"cantidad\": 1\n}"
            },
            "url": "{{compraApiUrl}}/compras"
          }
        },
        {
          "name": "Crear compra - producto inexistente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"productoId\": 99,\n  \"cantidad\": 1\n}"
            },
            "url": "{{compraApiUrl}}/compras"
          }
        },
        {
          "name": "Crear compra - stock insuficiente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"productoId\": 1,\n  \"cantidad\": 999\n}"
            },
            "url": "{{compraApiUrl}}/compras"
          }
        },
        {
          "name": "Crear compra - servicio caido (detener producto-api antes)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"productoId\": 1,\n  \"cantidad\": 1\n}"
            },
            "url": "{{compraApiUrl}}/compras"
          }
        }
      ]
    }
  ]
}
